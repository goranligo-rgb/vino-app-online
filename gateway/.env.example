# VINO GATEWAY - primjer konfiguracije.
# Kopiraj u ~/gateway/.env na Raspberry Pi-ju i popuni vrijednosti.
# .env NIKAD ne ide u git (u .gitignore je) - samo ovaj .env.example.

# --- Supabase (obavezno) ----------------------------------------------------
# URL projekta, npr. https://xxxxxxxxxxxx.supabase.co (bez zavrsnog /)
SUPABASE_URL=
# service_role key (Supabase -> Project Settings -> API -> service_role).
# Zaobilazi RLS, drzi ga samo na Pi-ju. NIKAD u repozitorij.
SUPABASE_SERVICE_KEY=

# --- Serijski portovi -------------------------------------------------------
# Grana A = tankovi 1-20, grana B = tankovi 21-44 (po Tank.grana u bazi).
#
# PAZI - grane su fizicki na "obrnutim" portovima nego sto ime sugerira:
#   grana A je na /dev/ttyUSB1, grana B je na /dev/ttyUSB0.
# Zato PORT_A=/dev/ttyUSB1 i PORT_B=/dev/ttyUSB0. Ako zamijenis, cijela grana
# javlja "nema veze" (upiti idu na krivu zicu).
#
# Redoslijed /dev/ttyUSB* ovisi o tome koji je adapter Linux prvi vidio pri
# bootu - nakon svakog odspajanja/prespajanja adaptera PROVJERI:
#   ls -l /dev/serial/by-id/     (stabilna imena, po serijskom broju adaptera)
# Ako se redoslijed voli mijenjati, upisi ovdje bas te /dev/serial/by-id/... putanje.
PORT_A=/dev/ttyUSB1
PORT_B=/dev/ttyUSB0

# Potvrdeno testom na kontroleru: 9600 8N1
BAUDRATE=9600
PARITY=N
BYTESIZE=8
STOPBITS=1

# Timeout po upitu (s) i broj pokusaja po registru prije nego se tank proglasi offline.
MODBUS_TIMEOUT=1.0
MODBUS_POKUSAJA=2
# Pauza izmedu dva tanka na istoj sabirnici (s) - RS485 voli malo zraka.
PAUZA_IZMEDU_TANKOVA=0.05

# 3 = read holding registers (zadano), 4 = read input registers
MODBUS_FUNKCIJA=3
# 6 = write single register (zadano), 16 = write multiple registers
MODBUS_FUNKCIJA_PISANJE=6

# --- Registri ---------------------------------------------------------------
# POTVRDENO: 0x0100 = sonda P1, vrijednost /10 (procitano 153 = 15,3 C).
REG_TEMP=0x0100
DJELITELJ_TEMP=10

# POTVRDENO discoveryjem 16.08.2026. na zivom kontroleru (test tank 2):
# 0x042D = set point (SEt), djelitelj 10 - upis 100 i 105 pratio je displej.
# Isti registar sluzi i za citanje i za upis. Prazno = zadana temperatura se
# uzima iz baze (Tank.zadanaTemp), a komande ZADANA_TEMP ostaju NA_CEKANJU.
REG_SETPOINT=0x042D
DJELITELJ_SETPOINT=10

# Hy = diferencijal hladjenja. POTVRDENO: 0x0408, ali vrijednost je
# PAKIRANA U GORNJI BAJT: registar = (Hy * DJELITELJ_HY) << HY_POMAK_BITOVA.
# Izmjereno: Hy 2,0 -> 5120, 1,5 -> 3840, 0,5 -> 1280. Citanje ide obrnuto.
# HY_POMAK_BITOVA=0 znaci "bez pakiranja" (obicna vrijednost u donjem bajtu).
REG_HY=0x0408
DJELITELJ_HY=10
HY_POMAK_BITOVA=8

# Dozvoljeni raspon kod upisa Hy. XR75CX podnosi 0,1-25,5 K, ali za vino je
# dovoljno do 3,0 K. Mora pratiti LIMITI.HY u lib/tank-komanda.ts!
HY_MIN=0.1
HY_MAX=3.0

# ON/OFF hladjenja: kontroler NEMA izlozen Modbus registar za ukljucivanje, pa se
# gasi "meko" - set point se digne na SOFT_OFF_TEMP. Aplikacija tank sa zadanom
# temperaturom SOFT_OFF_TEMP prikazuje kao "hladjenje iskljuceno" i za njega ne
# otvara alarm PREVISOKA_TEMP. Mora biti isto kao SOFT_OFF_TEMP u lib/tank-komanda.ts!
SOFT_OFF_TEMP=20.0

# Registri koje gateway NIKAD ne dira - ni citanje, ni upis (zarezom odvojeno).
# 0x0420 je MODBUS ADRESA SAMOG KONTROLERA: upis u njega je kod discoveryja
# prepisao adrese vise kontrolera odjednom i srusio cijelu granu (svi uredaji
# zavrse na istoj adresi; popravlja se rucno na svakom kontroleru posebno).
# Prazna vrijednost NE prazni popis nego vraca ovaj zadani (namjerno).
REGISTRI_ZABRANJENI=0x0420

# Statusni registar (relej hladjenja, greska sonde) + brojevi bitova (0 = najnizi).
# Prazno = hladjenjeAktivno se procjenjuje kao (temperatura > zadana),
# a greska sonde se prepoznaje samo po nemogucoj vrijednosti temperature.
REG_STATUS=
BIT_HLADJENJE=
BIT_GRESKA_SONDE=

# Temperatura izvan ovog raspona = neispravna sonda (kabel, kratki spoj, P1).
TEMP_MIN_VALJANA=-60
TEMP_MAX_VALJANA=150

# --- Ciklus i alarmi --------------------------------------------------------
# Razmak izmedu ciklusa (s). 120 = svake 2 minute.
CIKLUS_SEKUNDI=120
# Koliko uzastopnih ciklusa bez odgovora prije alarma NEMA_VEZE.
OFFLINE_CIKLUSA=3

# --- Komande (Faza B) -------------------------------------------------------
# Glavni prekidac. false = gateway samo cita, TankKomanda se ni ne dohvaca.
KOMANDE_OMOGUCENE=true

# Sigurnosna ograda: komanda starija od ovoliko minuta se NE izvrsava nego ide
# u NEUSPJELO. Sprjecava da zaboravljeni zahtjev opali sat vremena kasnije.
KOMANDA_MAX_MINUTA=30

# Koliko ciklusa se neuspjela komanda ponavlja prije trajnog NEUSPJELO.
KOMANDA_MAX_POKUSAJA=3

# --- SMS obavijesti (Infobip) -----------------------------------------------
# OPCIONALNO. Bez INFOBIP_API_KEY / INFOBIP_BASE_URL / SMS_BROJEVI gateway radi
# kao i prije, samo se SMS preskace (u logu pise zasto).
#
# SMS ide SAMO za alarm temperature koji NEPREKIDNO traje dulje od SMS_ODGODA_MIN,
# jednom po dogadaju, plus jedna poruka kad se alarm zatvori. Greska sonde, "nema
# veze" i tank u soft-OFF stanju se NE javljaju.
#
# Provjera postave (posalje jednu poruku pa izade):
#   ~/gateway/venv/bin/python ~/gateway/gateway.py --test-sms
#
# Base URL je onaj iz Infobip portala (svaki racun ima svoj poddomenu).
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=
# Ime posiljatelja (alfanumericki sender). Za Hrvatsku mora biti registriran kod
# Infobipa; ako nije, upisi broj koji su ti dodijelili.
SMS_POSILJATELJ=Vinarija
# Naziv koji ide u sam tekst poruke ("ALARM Vinarija: Tank 17 ...").
SMS_NAZIV=Vinarija
# Primatelji, medunarodni oblik bez plusa, odvojeni zarezom (do tri broja).
SMS_BROJEVI=385911234567,385981234567,385991234567

# Glavni prekidac modula (kill switch bez brisanja kljuca).
SMS_OMOGUCEN=true
# Koliko minuta alarm mora trajati prije nego se posalje SMS.
SMS_ODGODA_MIN=15
# Koliko ciklusa se ponavlja neuspjelo slanje prije nego se odustane.
SMS_POKUSAJA=3
# Ograda protiv troska: najvise ovoliko poruka na sat (sve vrste zajedno).
SMS_MAX_NA_SAT=20
SMS_TIMEOUT=10

# --- Logiranje i HTTP -------------------------------------------------------
LOG_FILE=/home/vinarija/gateway/gateway.log
LOG_LEVEL=INFO
LOG_MAX_MB=5
LOG_BACKUP=5

HTTP_TIMEOUT=15
HTTP_POKUSAJA=3
