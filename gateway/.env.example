# VINO GATEWAY - primjer konfiguracije.
# Kopiraj u ~/gateway/.env na Raspberry Pi-ju i popuni vrijednosti.
# .env NIKAD ne ide u git (u .gitignore je) - samo ovaj .env.example.

# --- Supabase (obavezno) ----------------------------------------------------
# URL projekta, npr. https://xxxxxxxxxxxx.supabase.co (bez zavrsnog /)
SUPABASE_URL=
# service_role key (Supabase -> Project Settings -> API -> service_role).
# Zaobilazi RLS, drzi ga samo na Pi-ju. NIKAD u repozitorij.
SUPABASE_SERVICE_KEY=

# --- Serijski portovi -------------------------------------------------------
# Grana A = tankovi 1-22, grana B = tankovi 23-44 (po Tank.grana u bazi).
PORT_A=/dev/ttyUSB0
PORT_B=/dev/ttyUSB1

# Potvrdeno testom na kontroleru: 9600 8N1
BAUDRATE=9600
PARITY=N
BYTESIZE=8
STOPBITS=1

# Timeout po upitu (s) i broj pokusaja po registru prije nego se tank proglasi offline.
MODBUS_TIMEOUT=1.0
MODBUS_POKUSAJA=2
# Pauza izmedu dva tanka na istoj sabirnici (s) - RS485 voli malo zraka.
PAUZA_IZMEDU_TANKOVA=0.05

# 3 = read holding registers (zadano), 4 = read input registers
MODBUS_FUNKCIJA=3
# 6 = write single register (zadano), 16 = write multiple registers
MODBUS_FUNKCIJA_PISANJE=6

# --- Registri ---------------------------------------------------------------
# POTVRDENO: 0x0100 = sonda P1, vrijednost /10 (procitano 153 = 15,3 C).
REG_TEMP=0x0100
DJELITELJ_TEMP=10

# NIJE potvrdeno - ostavi prazno dok ne potvrdis s discover_registers.py.
# Prazno REG_SETPOINT = zadana temperatura se uzima iz baze (Tank.zadanaTemp),
# a komande ZADANA_TEMP ostaju NA_CEKANJU s napomenom "ceka discovery".
# Isti registar sluzi i za citanje i za upis set pointa.
REG_SETPOINT=
DJELITELJ_SETPOINT=10

# Hy = diferencijal hladjenja (0,3-3,0 K). NIJE potvrdeno - prazno = komande HY
# ostaju NA_CEKANJU. Djelitelj 10 znaci da se 0,5 K salje kao 5.
REG_HY=
DJELITELJ_HY=10

# Standby / device on-off (Dixell "onF"). NIJE potvrdeno - prazno = komande
# HLADJENJE_ON i HLADJENJE_OFF ostaju NA_CEKANJU.
# Vrijednosti provjeri kod discoveryja: kod nekih izvedbi je obrnuto (1 = standby).
REG_ONOFF=
ONOFF_VRIJEDNOST_ON=1
ONOFF_VRIJEDNOST_OFF=0

# Statusni registar (relej hladjenja, greska sonde) + brojevi bitova (0 = najnizi).
# Prazno = hladjenjeAktivno se procjenjuje kao (temperatura > zadana),
# a greska sonde se prepoznaje samo po nemogucoj vrijednosti temperature.
REG_STATUS=
BIT_HLADJENJE=
BIT_GRESKA_SONDE=

# Temperatura izvan ovog raspona = neispravna sonda (kabel, kratki spoj, P1).
TEMP_MIN_VALJANA=-60
TEMP_MAX_VALJANA=150

# --- Ciklus i alarmi --------------------------------------------------------
# Razmak izmedu ciklusa (s). 120 = svake 2 minute.
CIKLUS_SEKUNDI=120
# Koliko uzastopnih ciklusa bez odgovora prije alarma NEMA_VEZE.
OFFLINE_CIKLUSA=3

# --- Komande (Faza B) -------------------------------------------------------
# Glavni prekidac. false = gateway samo cita, TankKomanda se ni ne dohvaca.
KOMANDE_OMOGUCENE=true

# Sigurnosna ograda: komanda starija od ovoliko minuta se NE izvrsava nego ide
# u NEUSPJELO. Sprjecava da zaboravljeni zahtjev opali sat vremena kasnije.
KOMANDA_MAX_MINUTA=30

# Koliko ciklusa se neuspjela komanda ponavlja prije trajnog NEUSPJELO.
KOMANDA_MAX_POKUSAJA=3

# --- Logiranje i HTTP -------------------------------------------------------
LOG_FILE=/home/vinarija/gateway/gateway.log
LOG_LEVEL=INFO
LOG_MAX_MB=5
LOG_BACKUP=5

HTTP_TIMEOUT=15
HTTP_POKUSAJA=3
