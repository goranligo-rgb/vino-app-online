model ArhivaPunjenjeStavka {
  id                      String              @id @default(uuid())
  arhivaPunjenjeId        String
  izvornaPunjenjeStavkaId String?
  nazivSorte              String
  sortaId                 String?
  opis                    String?
  kolicinaKgGrozdja       Float?
  kolicinaLitara          Float
  datumBerbe              DateTime?           @db.Timestamptz(6)
  godinaBerbe             Int?
  polozaj                 String?
  parcela                 String?
  vinograd                String?
  oznakaBerbe             String?
