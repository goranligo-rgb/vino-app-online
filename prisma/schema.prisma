  preporucenaAktivacija  String?
  sljedeciKorak          String?
  datumSljedecegKontakta DateTime?
  zavrsnaOcjena          String?

  // 12. BILJEŠKE
  biljeska        String?
  internaBiljeska String?

  // 13. PREPORUČENA AKCIJA / AKTIVACIJA (korak 19) - prije se tiho gubilo
  akcija6Plus1             Boolean @default(false)
  akcija12Plus2            Boolean @default(false)
  akcija24Plus4            Boolean @default(false)
  probneBoce               Boolean @default(false)
  gratisCase               Boolean @default(false)
  edukacijaKonobara        Boolean @default(false)
  degustacijaULokalu       Boolean @default(false)
  winePartyAktivacija      Boolean @default(false)
  posjetVinarijiAktivacija Boolean @default(false)
