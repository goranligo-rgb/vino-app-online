model PutnikKupac {
  id String @id @default(cuid())

  nazivLokala  String
  nazivFirme   String?
  vlasnik      String?
  kontaktOsoba String?

  telefon String?
  email   String?
  oib     String?

  adresa String?
  grad   String?
  regija String?

  // Excel kartica kupca - identifikacija
  sifraKupca String?

  // Odgovorna osoba za narudžbu
  narudzbaOsoba   String?
  narudzbaTelefon String?
  narudzbaEmail   String?

  // Odgovorna osoba za naplatu
  naplataOsoba   String?
  naplataTelefon String?
  naplataEmail   String?

  // Financijski uvjeti
  nacinPlacanja     String?
  garancijaPlacanja String?
  kreditniLimit     Float?

  gpsLat Float?
  gpsLng Float?

  tip        PutnikTipKupca        @default(OSTALO)
  status     PutnikKupacStatus     @default(POTENCIJALNI)
  kategorija PutnikKupacKategorija @default(C)

  napomena String?

  aktivan Boolean @default(true)

  ankete          PutnikAnketaKupca[]
  posjeti         PutnikPosjet[]
  akcije          PutnikAkcijaKupca[]
  promoMaterijali PutnikPromoKupca[]
  rezultati       PutnikRezultatObilaska[]
  dogovori        PutnikDogovor[]
  aktivnosti      PutnikAktivnost[]
  planObilaska    PutnikPlanObilaska[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikAnketaKupca {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  // 1. LOKAL
  tipLokala          String?
  razinaLokala       String?
  brojSjedecihMjesta Int?
  imaTerasu          Boolean @default(false)
  radiSezonski       Boolean @default(false)
  promet             String?
  najjaciDani        String?

  // 2. TRENUTNA PONUDA
  prodajeKucnoVino  Boolean @default(false)
  prodajeButelje    Boolean @default(false)
  prodajeRinfuza    Boolean @default(false)
  prodajePremium    Boolean @default(false)
  prodajeStranaVina Boolean @default(false)
  prodajePjenusce   Boolean @default(false)
  prodajeRose       Boolean @default(false)
  nemaPosebnuPonudu Boolean @default(false)

  // 3. VRSTE KOJE IDU
  ideBijelo     Boolean @default(false)
  ideCrno       Boolean @default(false)
  ideRose       Boolean @default(false)
  idePjenusci   Boolean @default(false)
  ideGrasevina  Boolean @default(false)
  ideSauvignon  Boolean @default(false)
  ideRizling    Boolean @default(false)
  ideChardonnay Boolean @default(false)
  ideMuskat     Boolean @default(false)
  ideFrankovka  Boolean @default(false)
  ideKupaza     Boolean @default(false)

  // 4. KONKURENCIJA
  konkurentskeVinarije         String?
  glavniKonkurent              String?
  razlogCijena                 Boolean @default(false)
  razlogPoznatost              Boolean @default(false)
  razlogKvaliteta              Boolean @default(false)
  razlogRabat                  Boolean @default(false)
  razlogDostava                Boolean @default(false)
  razlogOdnosDobavljac         Boolean @default(false)
  razlogGostiTraze             Boolean @default(false)
  razlogKonobariProdaju        Boolean @default(false)
  razlogCasePromo              Boolean @default(false)
  stoMuKodKonkurencijeOdgovara String?
  stoMuKodKonkurencijeSmeta    String?

  // 5. NABAVA
  nacinNabave         String?
  nazivVeletrgovca    String?
  kontaktVeletrgovca  String?
  uvjetiNabave        String?
  tkoDogovaraNarudzbu String?

  // 6. ODLUKA
  tkoOdlucuje            String?
  stvarniDonositelj      Boolean @default(false)
  trebaPricatiSVlasnikom Boolean @default(false)
  trebaPoslatiPonudu     Boolean @default(false)

  // 7. ŠTO IM JE VAŽNO
  vaznaCijena              Boolean @default(false)
  vaznaKvaliteta           Boolean @default(false)
  vaznaMarza               Boolean @default(false)
  vaznaDostava             Boolean @default(false)
  vazanBrend               Boolean @default(false)
  vaznaLokalnaPrica        Boolean @default(false)
  vaznaPreporukaHrane      Boolean @default(false)
  vaznaEdukacijaKonobara   Boolean @default(false)
  vazneCase                Boolean @default(false)
  vazanPromoMaterijal      Boolean @default(false)
  vazneAkcije              Boolean @default(false)
  vaznaSigurnostDobave     Boolean @default(false)
  vaznaJednostavnaNarudzba Boolean @default(false)

  // 8. NAŠA VINA / KOSTANJEVEC
  probaoNasaVina        String?
  misljenjeONama        String?
  poznajeVinariju       Boolean @default(false)
  cuoZaNas              Boolean @default(false)
  bioUVinariji          Boolean @default(false)
  zanimaGaPricaVinarije Boolean @default(false)

  // 9. MOTIVACIJA
  motiviraBoljaCijena      Boolean @default(false)
  motiviraAkcija12Plus2    Boolean @default(false)
  motiviraAkcija6Plus1     Boolean @default(false)
  motivirajuProbneBoce     Boolean @default(false)
  motivirajuCase           Boolean @default(false)
  motiviraVinskaKarta      Boolean @default(false)
  motiviraEdukacija        Boolean @default(false)
  motiviraDegustacija      Boolean @default(false)
  motiviraWineParty        Boolean @default(false)
  motiviraPosjetVinariji   Boolean @default(false)
  motiviraBoljaMarza       Boolean @default(false)
  motiviraPreporukaUzHranu Boolean @default(false)
  motiviraLokalnaPrica     Boolean @default(false)

  // 10. PREPREKE
  preprekaImaDobavljaca           Boolean @default(false)
  preprekaZadovoljanKonkurencijom Boolean @default(false)
  preprekaCijenaPrevisoka         Boolean @default(false)
  preprekaNePoznaVino             Boolean @default(false)
  preprekaNemaProstora            Boolean @default(false)
  preprekaKonobariNeZnaju         Boolean @default(false)
  preprekaMaliPromet              Boolean @default(false)
  preprekaVlasnikNeZeli           Boolean @default(false)
  preprekaTrebaProbati            Boolean @default(false)
  preprekaTrebaPonudu             Boolean @default(false)
  preprekaNijeTrenutak            Boolean @default(false)
  dodatnePrepreke                 String?

  // 11. POTENCIJAL
  potencijal             String?
  procjenaBocaMjesecno   Int?
  preporucenaAkcija      String?
  preporucenaAktivacija  String?
  sljedeciKorak          String?
  datumSljedecegKontakta DateTime?
  zavrsnaOcjena          String?

  // 12. BILJEŠKE
  biljeska        String?
  internaBiljeska String?

  // 13. PREPORUČENA AKCIJA / AKTIVACIJA (korak 19) - prije se tiho gubilo
  akcija6Plus1             Boolean @default(false)
  akcija12Plus2            Boolean @default(false)
  akcija24Plus4            Boolean @default(false)
  probneBoce               Boolean @default(false)
  gratisCase               Boolean @default(false)
  edukacijaKonobara        Boolean @default(false)
  degustacijaULokalu       Boolean @default(false)
  winePartyAktivacija      Boolean @default(false)
  posjetVinarijiAktivacija Boolean @default(false)
  vinskaKartaAktivacija    Boolean @default(false)
  promoMaterijalAktivacija Boolean @default(false)
  stalciLetciAktivacija    Boolean @default(false)
  posebnaCijenaAktivacija  Boolean @default(false)
  preporukaHraneVina       Boolean @default(false)
  lokalnaPricaAktivacija   Boolean @default(false)
  premiumPozicioniranje    Boolean @default(false)

  preporucenaKolicina      Int?
  preporucenaCijena        String?
  preporuceniRok           String?
  preporucenaAkcijaDetalji String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikPosjet {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  datum     DateTime @default(now())
  putnikIme String?

  zainteresiran     Boolean @default(false)
  nijeZainteresiran Boolean @default(false)
  uzimaNaseVino     Boolean @default(false)
  uzimaKonkurenciju Boolean @default(false)
  zeliPonudu        Boolean @default(false)
  zeliUzorke        Boolean @default(false)
  zeliEdukaciju     Boolean @default(false)
  zeliWineParty     Boolean @default(false)
  ponovnoObici      Boolean @default(false)

  // Zasto je putnik dosao (redovni obilazak, reklamacija, dogovor...) - slobodan
  // tekst na VRHU posjet forme. Odvojeno od `biljeska` (sadrzaj/ishod posjeta,
  // dno forme) i od `problemi` (napomene s terena).
  razlogPosjeta String?

  dogovoreno     String?
  biljeska       String?
  sljedeciKorak  String?
  datumSljedeceg DateTime?

  // Excel kartica kupca - reklamni materijal i dug
  reklamniMaterijal String?
  ukupanDug         Float?
  dospjeliDug       Float?

  // Faza 4B - dnevni izvještaj / teren
  mjesto          String?
  vrijemeOd       String?
  vrijemeDo       String?
  tipObilaska     String?
  tipPremise      String?
  stanjeProizvoda String?
  kilometri       Float?
  cijena          String?
  problemi        String?

  aktDegustacija     Boolean @default(false)
  aktVidljivost      Boolean @default(false)
  aktSlaganjeRobe    Boolean @default(false)
  aktIstaknuteCijene Boolean @default(false)
  aktAkcijskaCijena  Boolean @default(false)

  stavke      PutnikPosjetStavka[]
  promoOtpisi PutnikPromoKupca[]
  slike       PutnikPosjetSlika[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikPosjetSlika {
  id       String       @id @default(cuid())
  posjetId String
  posjet   PutnikPosjet @relation(fields: [posjetId], references: [id], onDelete: Cascade)

  tip          PutnikPosjetSlikaTip
  putanja      String // putanja u Supabase bucketu (ne URL)
  mimeType     String?
  velicinaByte Int?
  putnikIme    String?

  createdAt DateTime @default(now())

  @@index([posjetId])
  @@index([posjetId, tip])
}

model PutnikPosjetStavka {
  id       String       @id @default(cuid())
  posjetId String
  posjet   PutnikPosjet @relation(fields: [posjetId], references: [id], onDelete: Cascade)

  nazivProizvoda String
  kolicina       Float?
  jedinica       String? @default("kom")

  // Faza 5B - gratis (prijedlog iz dogovora, putnik može override)
  gratis Int @default(0)

  // Faza 6 - popis za pripremu: ODMAH / PRIPREMITI / PRIPREMLJENO / ISPORUCENO
  statusPripreme String @default("ODMAH")

  // Faza 7 - veza na katalog vina (za obračun zalihe po putniku).
  // Popunjeno kad putnik odabere vino iz kataloga; null = slobodan unos (ne prati se u zalihi).
  artiklId String?
  artikl   PutnikVinoArtikl? @relation(fields: [artiklId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([posjetId])
  @@index([artiklId])
}

model PutnikAkcijaTemplate {
  id    String  @id @default(cuid())
  naziv String
  opis  String?
  tip   String?

  kolicinaKupnje Int?
  gratisKolicina Int?
  trajanjeDana   Int?

  aktivna Boolean @default(true)

  akcijeKupaca PutnikAkcijaKupca[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikAkcijaKupca {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  templateId String?
  template   PutnikAkcijaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  naziv String
  opis  String?

  datumPocetka   DateTime?
  datumZavrsetka DateTime?

  kolicinaKupnje Int?
  gratisKolicina Int?

  status   PutnikAkcijaStatus   @default(DOGOVORENA)
  rezultat PutnikRezultatAkcije @default(CEKA_SE)

  napomena String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikPromoKupca {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  datumPredaje DateTime @default(now())
  tip          String

  naziv    String?
  kolicina Int     @default(0)

  status   String?
  predao   String?
  napomena String?

  // Faza 5A - otpis iz promo zalihe (veza na katalog artikala)
  artiklId           String?
  artikl             PutnikPromoArtikl? @relation(fields: [artiklId], references: [id])
  otpisaoKorisnikIme String?

  // Faza 5D - otpis kreiran tijekom posjeta (null = otpisan na /putnik/promo)
  posjetId String?
  posjet   PutnikPosjet? @relation(fields: [posjetId], references: [id], onDelete: SetNull)

  // Faza 6 - popis za pripremu: ODMAH / PRIPREMITI / PRIPREMLJENO / ISPORUCENO
  statusPripreme String @default("ODMAH")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artiklId])
  @@index([posjetId])
}

model PutnikVinoArtikl {
  id      String  @id @default(cuid())
  naziv   String  @unique
  aktivan Boolean @default(true)

  // Faza 6 - zadana jedinica (L za rinfuzu, kom za butelje); override na formi
  zadanaJedinica String? @default("kom")

  // Faza 7 - zaduženja po putniku (ulaz u zalihu) i prodajne/gratis stavke (izlaz)
  zaduzenja PutnikVinoZaduzenje[]
  stavke    PutnikPosjetStavka[]

  // Faza 9 - povrat vina iz vozila u skladište (izlaz iz zalihe vozila)
  povrati PutnikVinoPovrat[]

  createdAt DateTime @default(now())
}

// Faza 7 - zaduženje vina putniku (ulaz u zalihu vozila).
// Kao promo ulaz (PutnikPromoUlaz), ali vezano na konkretnog putnika (putnikIme).
// Stanje po putniku = Σ zaduzenja − Σ (ODMAH stavke: kolicina + gratis). Zaduzuju samo L1/2.
model PutnikVinoZaduzenje {
  id       String           @id @default(cuid())
  artiklId String
  artikl   PutnikVinoArtikl @relation(fields: [artiklId], references: [id])

  putnikIme String // kojem putniku se zadužuje (kao PutnikPosjet.putnikIme)
  kolicina  Float
  jedinica  String? @default("kom")

  datum           DateTime @default(now())
  unioKorisnikIme String? // L1/2 koji je zadužio
  napomena        String?

  createdAt DateTime @default(now())

  @@index([artiklId])
  @@index([putnikIme])
}

model PutnikPromoArtikl {
  id      String  @id @default(cuid())
  naziv   String  @unique
  aktivan Boolean @default(true)

  ulazi  PutnikPromoUlaz[]
  otpisi PutnikPromoKupca[]

  // Faza 9 - povrat promo materijala iz vozila u skladište (izlaz iz zalihe vozila)
  povrati PutnikPromoPovrat[]

  createdAt DateTime @default(now())
}

model PutnikPromoUlaz {
  id       String            @id @default(cuid())
  artiklId String
  artikl   PutnikPromoArtikl @relation(fields: [artiklId], references: [id])

  // Faza 8 - promo zaliha po putniku (analogno PutnikVinoZaduzenje).
  // Nullable zbog kompatibilnosti sa starim globalnim redovima; novi ulazi uvijek imaju putnika.
  putnikIme String?

  kolicina        Int
  datum           DateTime @default(now())
  unioKorisnikIme String?
  napomena        String?

  createdAt DateTime @default(now())

  @@index([artiklId])
  @@index([putnikIme])
}

// Faza 9 - povrat vina iz vozila u skladište (IZLAZ iz zalihe vozila).
// Zrcali PutnikVinoZaduzenje, ali obrnuti smjer: putnik vraća neprodanu robu, L1/2 je prime.
// Ostalo u autu = Σ zaduzeno − Σ (prodano + gratis) − Σ vraceno. Vraćaju samo L1/2.
model PutnikVinoPovrat {
  id       String           @id @default(cuid())
  artiklId String
  artikl   PutnikVinoArtikl @relation(fields: [artiklId], references: [id])

  putnikIme String // iz čijeg auta se vraća (kao PutnikVinoZaduzenje.putnikIme)
  kolicina  Float
  jedinica  String? @default("kom")

  datum             DateTime @default(now())
  primioKorisnikIme String? // L1/2 koji je primio povrat u skladište
  napomena          String?

  createdAt DateTime @default(now())

  @@index([artiklId])
  @@index([putnikIme])
}

// Faza 9 - povrat promo materijala iz vozila u skladište, analogno PutnikVinoPovrat.
// Promo količina je Int (kom). Ostalo u autu = Σ zaduzeno − Σ otpisano − Σ vraceno.
model PutnikPromoPovrat {
  id       String            @id @default(cuid())
  artiklId String
  artikl   PutnikPromoArtikl @relation(fields: [artiklId], references: [id])

  putnikIme String
  kolicina  Int

  datum             DateTime @default(now())
  primioKorisnikIme String?
  napomena          String?

  createdAt DateTime @default(now())

  @@index([artiklId])
  @@index([putnikIme])
}

model PutnikRezultatObilaska {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  datum            DateTime           @default(now())
  prodajaTrend     PutnikProdajaTrend @default(NEPOZNATO)
  postotakPromjene Float?

  rezultatAkcije PutnikRezultatAkcije @default(CEKA_SE)

  kupacZadovoljan  Boolean @default(false)
  zeliNastaviti    Boolean @default(false)
  traziNovuAkciju  Boolean @default(false)
  trebaVisePodrske Boolean @default(false)
  odustaje         Boolean @default(false)

  komentar       String?
  sljedeciKorak  String?
  datumSljedeceg DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikDogovor {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  datum DateTime @default(now())

  nacinKupnje String?

  kupujeDirektno          Boolean @default(false)
  kupujePrekoDistributera Boolean @default(false)
  kupujePrekoVeletrgovca  Boolean @default(false)

  pocetnaNarudzba    String?
  dogovorenaKolicina Int?
  dogovorenaAkcija   String?

  akcija6Plus1  Boolean @default(false)
  akcija12Plus2 Boolean @default(false)
  akcija24Plus4 Boolean @default(false)

  posebnaCijenaDogovorena Boolean @default(false)

  posebnaCijena String?
  rabat         String?

  caseDogovorene Boolean @default(false)
  brojCasa       Int?
  tipCasa        String?
  caseLogo       Boolean @default(false)
  caseNapomena   String?

  promoDogovoren Boolean @default(false)

  vinskaKarta Boolean @default(false)
  plakati     Boolean @default(false)
  letci       Boolean @default(false)
  stalci      Boolean @default(false)
  menuHolder  Boolean @default(false)
  promoPolice Boolean @default(false)
  ledReklama  Boolean @default(false)

  promoNapomena String?

  uzorciDogovoreni Boolean @default(false)
  uzorciDetalji    String?

  edukacijaDogovorena Boolean   @default(false)
  datumEdukacije      DateTime?
  edukacijaDetalji    String?

  degustacijaDogovorena Boolean   @default(false)
  datumDegustacije      DateTime?
  degustacijaDetalji    String?

  winePartyDogovoren Boolean   @default(false)
  datumWineParty     DateTime?
  winePartyDetalji   String?

  posjetVinarijiDogovoren Boolean   @default(false)
  datumPosjetaVinariji    DateTime?
  posjetVinarijiDetalji   String?

  uvjetiPlacanja    String?
  rokPlacanja       String?
  dostava           String?
  minimalnaNarudzba String?

  tkoPotvrduje     String?
  kontaktZaPotvrdu String?

  rokPotvrde     DateTime?
  datumSljedeceg DateTime?

  trebaPonudu          Boolean @default(false)
  trebaPredracun       Boolean @default(false)
  trebaNazvati         Boolean @default(false)
  trebaDostavitiUzorke Boolean @default(false)
  trebaPonovnoObici    Boolean @default(false)

  status String?

  zakljucak String?
  napomena  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dnevnik aktivnosti praćenja (poglavito za potencijalne kupce).
// Po uzoru na Excel KARTICA_KUPCA - POTENCIJALNI: ponavljajući unos.
model PutnikAktivnost {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  datum DateTime @default(now())

  opis             String?
  tko              String?
  stoNastaviti     String?
  sljedecaAktivnost String?
  datumSljedece    DateTime?

  vjerojatnostZakljucenja Int?

  zabiljeska String?

  putnikIme String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kupacId])
}

// Prodajna ruta / plan obilaska - generira se po ABC(D) kadenci za 3 mjeseca.
model PutnikPlanObilaska {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  datum      DateTime
  tjedan     Int?
  kategorija String?
  status     String  @default("PLANIRANO")

  // Vlasnik-putnik rute (analogno PutnikPosjet.putnikIme). NULL = stari/zajednicki
  // auto plan; rucni unosi se vode po putniku. Auto-gen i dalje radi zajednicki.
  putnikIme String?

  // Labava veza na obavljeni posjet (bez FK-a; posjet je u domeni 4B).
  obavljenoPosjetId String?

  napomena String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kupacId])
  @@index([datum])
  @@index([putnikIme])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVIDENCIJA RADNOG VREMENA (Faza 1)
// Jedan redak = jedan dolazak/odlazak. Vise redaka po danu je dopusteno
// (izlazak i povratak), pa se dnevni zbroj racuna zbrajanjem redaka.
// ─────────────────────────────────────────────────────────────────────────────

model RadnaPrijava {
  id       String    @id @default(cuid())
  userId   String
  datum    DateTime  @db.Date // dan na koji se zapis odnosi (Europe/Zagreb)
  dolazakU DateTime
  odlazakU DateTime? // NULL = korisnik je jos prijavljen
  napomena String?

  // Tko je i kad rucno ispravio zapis (npr. zaboravljena odjava). Projekt vodi
  // autorstvo kolonama na retku (kao Zadatak.izvrsio/zadao), ne kroz ActivityLog.
  uredioId String?
  uredenoU DateTime?

  createdAt DateTime @default(now())

  user   User  @relation("RadnaPrijavaKorisnik", fields: [userId], references: [id])
  uredio User? @relation("RadnaPrijavaUredio", fields: [uredioId], references: [id])

  @@index([userId, datum])
  @@index([datum])
}

// Drzavni praznici (puni se sada, koristi ih Faza 2 za godisnje odmore).
model Praznik {
  id    String   @id @default(cuid())
  datum DateTime @unique @db.Date
  naziv String
}
