}

model PunjenjeStavka {
  id                String        @id @default(uuid())
  punjenjeId        String
  nazivSorte        String
  sortaId           String?
  opis              String?
  kolicinaKgGrozdja Float?
  kolicinaLitara    Float
  datumBerbe        DateTime?
  godinaBerbe       Int?
  polozaj           String?
  parcela           String?
  vinograd          String?
  oznakaBerbe       String?
  secer             Float?
  kiseline          Float?
  ph                Float?
  napomenaBerbe     String?
  // --- Maceracija: dogadja se PRIJE ulaska u tank, pa zivi uz podatke berbe ---
  // NULL  = nije se pitalo (sve zatecene stavke)
  // false = izricito nije bilo maceracije
  // true  = bilo je maceracije; trajanje je u maceracijaSati
  // Sati su broj, ne tekst, da se maceracije mogu usporedjivati kroz godine.
  // Slobodan opis ("preko noci", "na kljucu") ide u napomenaBerbe.
  maceracija        Boolean?
  maceracijaSati    Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  obrisano          Boolean       @default(false)
  obrisanoAt        DateTime?
  obrisaoKorisnikId String?
  punjenje          PunjenjeTanka @relation(fields: [punjenjeId], references: [id], onDelete: Cascade)
  sorta             Sorta?        @relation(fields: [sortaId], references: [id])

  @@index([punjenjeId])
  @@index([sortaId])
  @@index([obrisano])
}

