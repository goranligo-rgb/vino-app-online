generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(uuid())
  ime            String
  username       String?       @unique
  email          String        @unique
  password       String
  role           Role
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  activityLogs   ActivityLog[]
  additions      Addition[]
  measurements   Measurement[]
  mixings        Mixing[]
  mjerenja       Mjerenje[]
  radnje         Radnja[]
  transfers      Transfer[]
  zadaciIzvrseni Zadatak[]     @relation("ZadatakIzvrsio")
  zadaciZadani   Zadatak[]     @relation("ZadatakZadao")
}

model Tank {
  id                 String           @id @default(uuid())
  broj               Int              @unique
  kapacitet          Float
  kolicinaVinaUTanku Float?           @default(0)
  tip                String?
  opis               String?
  createdAt          DateTime         @default(now())
  sorta              String?
  nazivVina          String?
  godiste            Int?
  additions          Addition[]
  blendIzvori        BlendIzvor[]     @relation("CiljniBlendTank")
  kaoIzvorBlenda     BlendIzvor[]     @relation("IzvorBlendTank")
  documents          Document[]
  izlaziVina         IzlazVina[]
  measurements       Measurement[]
  targetMixings      Mixing[]         @relation("TargetTankMixings")
  mixingSources      MixingSource[]
  mjerenja           Mjerenje[]
  pretociKaoCilj     Pretok[]         @relation("CiljniPretoci")
  pretociKaoIzvor    PretokIzvor[]    @relation("IzvorniPretoci")
  pretokMjerenja     PretokMjerenje[]
  pretokSnapshoti    PretokSnapshot[]
  punjenja           PunjenjeTanka[]
  radnje             Radnja[]
  currentContent     TankContent?
  udjeliSorti        TankSortaUdio[]
  sourceTransfers    Transfer[]       @relation("SourceTankTransfers")
  targetTransfers    Transfer[]       @relation("TargetTankTransfers")
  zadaci             Zadatak[]
}

model Pretok {
  id         String           @id @default(uuid())
  datum      DateTime         @default(now())
  ciljTankId String
  napomena   String?
  createdAt  DateTime         @default(now())
  tip        String           @default("OBICNI")
  ciljTank   Tank             @relation("CiljniPretoci", fields: [ciljTankId], references: [id])
  izvori     PretokIzvor[]
  mjerenja   PretokMjerenje[]
  snapshoti  PretokSnapshot[]

  @@index([ciljTankId])
  @@index([createdAt])
  @@index([tip])
}

model PretokIzvor {
  id       String @id @default(uuid())
  pretokId String
  tankId   String
  kolicina Float
  pretok   Pretok @relation(fields: [pretokId], references: [id], onDelete: Cascade)
  tank     Tank   @relation("IzvorniPretoci", fields: [tankId], references: [id])

  @@index([pretokId])
  @@index([tankId])
}

model PretokSnapshot {
  id             String                @id @default(uuid())
  pretokId       String
  tankId         String
  uloga          String
  brojTanka      Int?
  kolicinaPrije  Float?
  sortaPrije     String?
  nazivVinaPrije String?
  godistePrije   Int?
  kapacitetPrije Float?
  tipTankaPrije  String?
  opisPrije      String?
  createdAt      DateTime              @default(now())
  pretok         Pretok                @relation(fields: [pretokId], references: [id], onDelete: Cascade)
  tank           Tank                  @relation(fields: [tankId], references: [id])
  blendovi       PretokSnapshotBlend[]
  sorte          PretokSnapshotSorta[]

  @@index([pretokId])
  @@index([tankId])
  @@index([uloga])
}

model PretokSnapshotSorta {
  id         String         @id @default(uuid())
  snapshotId String
  nazivSorte String
  postotak   Float
  createdAt  DateTime       @default(now())
  snapshot   PretokSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
}

model PretokSnapshotBlend {
  id                String         @id @default(uuid())
  snapshotId        String
  izvorTankId       String?
  izvorArhivaVinaId String?
  nazivVina         String?
  sorta             String?
  kolicina          Float
  postotak          Float
  createdAt         DateTime       @default(now())
  snapshot          PretokSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([izvorTankId])
  @@index([izvorArhivaVinaId])
}

model PretokMjerenje {
  id         String   @id @default(uuid())
  pretokId   String
  mjerenjeId String   @unique
  tankId     String
  createdAt  DateTime @default(now())
  mjerenje   Mjerenje @relation(fields: [mjerenjeId], references: [id], onDelete: Cascade)
  pretok     Pretok   @relation(fields: [pretokId], references: [id], onDelete: Cascade)
  tank       Tank     @relation(fields: [tankId], references: [id])

  @@index([pretokId])
  @@index([tankId])
}

model TankSortaUdio {
  id         String   @id @default(uuid())
  tankId     String
  nazivSorte String
  postotak   Float
  createdAt  DateTime @default(now())
  tank       Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
}

model Sorta {
  id             String           @id @default(uuid())
  naziv          String           @unique
  aktivna        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  punjenjeStavke PunjenjeStavka[]
}

model Preparat {
  id              String     @id @default(uuid())
  naziv           String     @unique
  strucnoIme      String
  preporucenaDoza Float
  mjernaJedinica  String
  izlaznaJedinica String
  opis            String?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  dozaDo          Float?
  dozaOd          Float?
  unitId          String?
  additions       Addition[]
}

model Addition {
  id                 String      @id @default(uuid())
  datum              DateTime
  userId             String
  tankId             String
  preparationId      String
  doza               Float
  jedinica           String
  volumenUTanku      Float
  izracunataKolicina Float
  izlaznaJedinica    String
  napomena           String?
  createdAt          DateTime    @default(now())
  preparatId         String?
  preparat           Preparat?   @relation(fields: [preparatId], references: [id])
  preparation        Preparation @relation(fields: [preparationId], references: [id])
  tank               Tank        @relation(fields: [tankId], references: [id])
  user               User        @relation(fields: [userId], references: [id])
}

model Transfer {
  id           String   @id @default(uuid())
  datum        DateTime
  userId       String
  sourceTankId String
  targetTankId String
  kolicina     Float
  napomena     String?
  createdAt    DateTime @default(now())
  sourceTank   Tank     @relation("SourceTankTransfers", fields: [sourceTankId], references: [id])
  targetTank   Tank     @relation("TargetTankTransfers", fields: [targetTankId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model Mixing {
  id           String         @id @default(uuid())
  datum        DateTime
  userId       String
  targetTankId String
  total        Float
  alkohol      Float?
  kiseline     Float?
  napomena     String?
  createdAt    DateTime       @default(now())
  targetTank   Tank           @relation("TargetTankMixings", fields: [targetTankId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  sources      MixingSource[]
}

model MixingSource {
  id           String @id @default(uuid())
  mixingId     String
  sourceTankId String
  kolicina     Float
  mixing       Mixing @relation(fields: [mixingId], references: [id], onDelete: Cascade)
  sourceTank   Tank   @relation(fields: [sourceTankId], references: [id])
}

model Measurement {
  id          String   @id @default(uuid())
  datum       DateTime
  tankId      String
  userId      String
  alkohol     Float?
  kiseline    Float?
  ph          Float?
  secer       Float?
  temperatura Float?
  napomena    String?
  createdAt   DateTime @default(now())
  tank        Tank     @relation(fields: [tankId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Document {
  id               String             @id @default(uuid())
  tankId           String
  vrsta            VrstaDokumentaVina
  naziv            String
  fileName         String
  fileUrl          String
  mimeType         String?
  datumDokumenta   DateTime?
  napomena         String?
  uploadedByUserId String?
  uploadedByIme    String?
  createdAt        DateTime           @default(now())
  tank             Tank               @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId])
  @@index([vrsta])
  @@index([datumDokumenta])
}

model ActivityLog {
  id         String   @id @default(uuid())
  datum      DateTime
  userId     String
  tip        String
  entityType String
  entityId   String
  opis       String
  payload    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model TankContent {
  id         String   @id @default(uuid())
  tankId     String   @unique
  sorta      String
  kolicina   Float
  datumUlaza DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tank       Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
}

model Unit {
  id                              String                  @id @default(uuid())
  naziv                           String
  tip                             String?
  faktor                          Float?
  preparationStockUnits           Preparation[]           @relation("PreparationStockUnit")
  preparations                    Preparation[]
  stockEntries                    PreparationStockEntry[]
  radnje                          Radnja[]
  zadaciKaoIzlaznaJedinica        Zadatak[]               @relation("ZadatakIzlaznaJedinica")
  zadaciKaoJedinica               Zadatak[]               @relation("ZadatakJedinica")
  zadatakStavkeKaoIzlaznaJedinica ZadatakStavka[]         @relation("ZadatakStavkaIzlaznaJedinica")
  zadatakStavkeKaoJedinica        ZadatakStavka[]         @relation("ZadatakStavkaJedinica")
}

model Preparation {
  id                         String                  @id @default(uuid())
  naziv                      String
  opis                       String?
  dozaOd                     Float?
  dozaDo                     Float?
  unitId                     String?
  strucnoIme                 String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  isKorekcijski              Boolean                 @default(false)
  korekcijaTip               KorekcijaTip?
  korekcijaJedinica          String?
  ucinakPoJedinici           Float?
  povecanjeParametra         Float?
  referentnaKolicina         Float?
  referentnaKolicinaJedinica String?
  referentniVolumen          Float?
  referentniVolumenJedinica  String?
  stanjeNaSkladistu          Float?                  @default(0)
  minimalnaKolicina          Float?                  @default(0)
  skladisnaJedinicaId        String?
  aktivan                    Boolean?                @default(true)
  additions                  Addition[]
  skladisnaJedinica          Unit?                   @relation("PreparationStockUnit", fields: [skladisnaJedinicaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit                       Unit?                   @relation(fields: [unitId], references: [id])
  skladisniUlazi             PreparationStockEntry[]
  radnje                     Radnja[]
  zadaci                     Zadatak[]
  zadatakStavke              ZadatakStavka[]
}

model PreparationStockEntry {
  id            String      @id @default(uuid())
  preparationId String
  kolicina      Float
  unitId        String
  datum         DateTime?   @default(now()) @db.Timestamp(6)
  dobavljac     String?
  brojDokumenta String?
  napomena      String?
  createdAt     DateTime?   @default(now()) @db.Timestamp(6)
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([preparationId])
  @@index([datum])
}

model Mjerenje {
  id                String          @id @default(cuid())
  tankId            String
  korisnikId        String?
  alkohol           Float?
  ukupneKiseline    Float?
  hlapiveKiseline   Float?
  slobodniSO2       Float?
  ukupniSO2         Float?
  secer             Float?
  ph                Float?
  temperatura       Float?
  bentotestDatum    DateTime?
  bentotestStatus   String?
  izmjerenoAt       DateTime        @default(now())
  napomena          String?
  jeRucno           Boolean         @default(true)
  korisnik          User?           @relation(fields: [korisnikId], references: [id])
  tank              Tank            @relation(fields: [tankId], references: [id], onDelete: Cascade)
  pretokVeze        PretokMjerenje?
  pocetnoZaPunjenja PunjenjeTanka[] @relation("PocetnoMjerenjePunjenja")

  @@index([tankId, izmjerenoAt])
}

model Zadatak {
  id                 String          @id @default(uuid())
  tankId             String
  zadaoKorisnikId    String
  izvrsioKorisnikId  String?
  vrsta              VrstaZadatka
  naslov             String?
  napomena           String?
  preparatId         String?
  doza               Float?
  jedinicaId         String?
  volumenUTanku      Float?
  izracunataKolicina Float?
  izlaznaJedinicaId  String?
  status             StatusZadatka   @default(OTVOREN)
  zadanoAt           DateTime        @default(now())
  izvrsenoAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tipZadatka         String?
  vezanaVrsta        VrstaZadatka?
  vezaniBrojDana     Int?
  vezaniNaslov       String?
  vezanaNapomena     String?
  parentZadatakId    String?
  zakljucanDo        DateTime?
  tipKorekcije       KorekcijaTip?
  trenutnaVrijednost Float?
  zeljenaVrijednost  Float?
  radnjas            Radnja[]
  izlaznaJedinica    Unit?           @relation("ZadatakIzlaznaJedinica", fields: [izlaznaJedinicaId], references: [id])
  izvrsioKorisnik    User?           @relation("ZadatakIzvrsio", fields: [izvrsioKorisnikId], references: [id])
  jedinica           Unit?           @relation("ZadatakJedinica", fields: [jedinicaId], references: [id])
  preparat           Preparation?    @relation(fields: [preparatId], references: [id])
  tank               Tank            @relation(fields: [tankId], references: [id])
  zadaoKorisnik      User            @relation("ZadatakZadao", fields: [zadaoKorisnikId], references: [id])
  stavke             ZadatakStavka[]
}

model ZadatakStavka {
  id                 String      @id @default(uuid())
  zadatakId          String
  preparatId         String
  doza               Float?
  jedinicaId         String?
  volumenUTanku      Float?
  izracunataKolicina Float?
  izlaznaJedinicaId  String?
  redoslijed         Int         @default(0)
  createdAt          DateTime    @default(now())
  izlaznaJedinica    Unit?       @relation("ZadatakStavkaIzlaznaJedinica", fields: [izlaznaJedinicaId], references: [id])
  jedinica           Unit?       @relation("ZadatakStavkaJedinica", fields: [jedinicaId], references: [id])
  preparat           Preparation @relation(fields: [preparatId], references: [id])
  zadatak            Zadatak     @relation(fields: [zadatakId], references: [id], onDelete: Cascade)

  @@index([zadatakId])
  @@index([preparatId])
}

model Radnja {
  id         String       @id @default(uuid())
  tankId     String
  korisnikId String
  zadatakId  String?
  vrsta      VrstaRadnje
  opis       String?
  napomena   String?
  preparatId String?
  kolicina   Float?
  jedinicaId String?
  createdAt  DateTime     @default(now())
  jedinica   Unit?        @relation(fields: [jedinicaId], references: [id])
  korisnik   User         @relation(fields: [korisnikId], references: [id])
  preparat   Preparation? @relation(fields: [preparatId], references: [id])
  tank       Tank         @relation(fields: [tankId], references: [id])
  zadatak    Zadatak?     @relation(fields: [zadatakId], references: [id])
}

model ArhivaVina {
  id             String                @id @default(uuid())
  tankId         String?
  brojTanka      Int?
  sorta          String?
  nazivVina      String?
  godiste        Int?
  kolicinaVina   Float
  kapacitetTanka Float?
  tipTanka       String?
  tipArhive      String?
  rokCuvanjaDo   DateTime?
  arhiviranoAt   DateTime              @default(now())
  napomena       String?
  punjenja       ArhivaPunjenjeTanka[]
  dokumenti      ArhivaVinaDokument[]
  mjerenja       ArhivaVinaMjerenje[]
  udjeliSorti    ArhivaVinaUdioSorte[]
  zadaci         ArhivaVinaZadatak[]
  blendIzvori    BlendIzvor[]

  @@index([tankId])
  @@index([arhiviranoAt])
}

model ArhivaVinaMjerenje {
  id                String     @id @default(uuid())
  arhivaVinaId      String
  izvornoMjerenjeId String?
  tankId            String?
  korisnikId        String?
  alkohol           Float?
  ukupneKiseline    Float?
  hlapiveKiseline   Float?
  slobodniSO2       Float?
  ukupniSO2         Float?
  secer             Float?
  ph                Float?
  temperatura       Float?
  bentotestDatum    DateTime?
  bentotestStatus   String?
  napomena          String?
  izmjerenoAt       DateTime
  arhiviranoAt      DateTime   @default(now())
  arhivaVina        ArhivaVina @relation(fields: [arhivaVinaId], references: [id], onDelete: Cascade)

  @@index([arhivaVinaId])
  @@index([tankId])
}

model ArhivaVinaZadatak {
  id                   String                    @id @default(uuid())
  arhivaVinaId         String
  izvorniZadatakId     String?
  tankId               String?
  vrsta                VrstaZadatka
  status               StatusZadatka
  naslov               String?
  napomena             String?
  doza                 Float?
  volumenUTanku        Float?
  izracunataKolicina   Float?
  preparatId           String?
  preparatNaziv        String?
  jedinicaId           String?
  jedinicaNaziv        String?
  izlaznaJedinicaId    String?
  izlaznaJedinicaNaziv String?
  zadaoKorisnikId      String?
  zadaoKorisnikIme     String?
  izvrsioKorisnikId    String?
  izvrsioKorisnikIme   String?
  zadanoAt             DateTime
  izvrsenoAt           DateTime?
  arhiviranoAt         DateTime                  @default(now())
  arhivaVina           ArhivaVina                @relation(fields: [arhivaVinaId], references: [id], onDelete: Cascade)
  stavke               ArhivaVinaZadatakStavka[]

  @@index([arhivaVinaId])
  @@index([tankId])
}

model ArhivaVinaZadatakStavka {
  id                   String            @id @default(uuid())
  arhivaZadatakId      String
  preparatId           String?
  preparatNaziv        String?
  doza                 Float?
  volumenUTanku        Float?
  izracunataKolicina   Float?
  jedinicaId           String?
  jedinicaNaziv        String?
  izlaznaJedinicaId    String?
  izlaznaJedinicaNaziv String?
  redoslijed           Int               @default(0)
  arhiviranoAt         DateTime          @default(now())
  arhivaZadatak        ArhivaVinaZadatak @relation(fields: [arhivaZadatakId], references: [id], onDelete: Cascade)

  @@index([arhivaZadatakId])
}

model ArhivaVinaUdioSorte {
  id                 String     @id @default(uuid())
  arhivaVinaId       String
  izvorniUdioSorteId String?
  nazivSorte         String
  postotak           Float
  arhiviranoAt       DateTime   @default(now())
  arhivaVina         ArhivaVina @relation(fields: [arhivaVinaId], references: [id], onDelete: Cascade)

  @@index([arhivaVinaId])
}

model BlendIzvor {
  id                String      @id @default(uuid())
  ciljTankId        String
  izvorTankId       String?
  izvorArhivaVinaId String?
  nazivVina         String?
  sorta             String?
  kolicina          Float
  postotak          Float
  createdAt         DateTime    @default(now())
  ciljTank          Tank        @relation("CiljniBlendTank", fields: [ciljTankId], references: [id], onDelete: Cascade)
  izvorArhivaVina   ArhivaVina? @relation(fields: [izvorArhivaVinaId], references: [id])
  izvorTank         Tank?       @relation("IzvorBlendTank", fields: [izvorTankId], references: [id])

  @@index([ciljTankId])
  @@index([izvorTankId])
  @@index([izvorArhivaVinaId])
}

model ArhivaVinaDokument {
  id               String             @id @default(uuid())
  arhivaVinaId     String
  vrsta            VrstaDokumentaVina
  naziv            String
  fileName         String
  fileUrl          String
  mimeType         String?
  datumDokumenta   DateTime?
  napomena         String?
  uploadedByUserId String?
  uploadedByIme    String?
  createdAt        DateTime           @default(now())
  arhivaVina       ArhivaVina         @relation(fields: [arhivaVinaId], references: [id], onDelete: Cascade)

  @@index([arhivaVinaId])
  @@index([vrsta])
  @@index([datumDokumenta])
}

model PunjenjeTanka {
  id                      String           @id @default(uuid())
  tankId                  String
  nazivVina               String?
  datumPunjenja           DateTime         @default(now())
  napomena                String?
  opis                    String?
  ukupnoLitara            Float            @default(0)
  ukupnoKgGrozdja         Float            @default(0)
  pocetnoMjerenjeId       String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  prethodnaKolicinaUTanku Float?           @default(0)
  prethodnaSorta          String?
  prethodniNazivVina      String?
  prethodnoGodiste        Int?
  prethodniSastavJson     Json?
  stavke                  PunjenjeStavka[]
  pocetnoMjerenje         Mjerenje?        @relation("PocetnoMjerenjePunjenja", fields: [pocetnoMjerenjeId], references: [id])
  tank                    Tank             @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId])
  @@index([pocetnoMjerenjeId])
}

model PunjenjeStavka {
  id                String        @id @default(uuid())
  punjenjeId        String
  nazivSorte        String
  sortaId           String?
  opis              String?
  kolicinaKgGrozdja Float?
  kolicinaLitara    Float
  datumBerbe        DateTime?
  godinaBerbe       Int?
  polozaj           String?
  parcela           String?
  vinograd          String?
  oznakaBerbe       String?
  secer             Float?
  kiseline          Float?
  ph                Float?
  napomenaBerbe     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  obrisano          Boolean       @default(false)
  obrisanoAt        DateTime?
  obrisaoKorisnikId String?
  punjenje          PunjenjeTanka @relation(fields: [punjenjeId], references: [id], onDelete: Cascade)
  sorta             Sorta?        @relation(fields: [sortaId], references: [id])

  @@index([punjenjeId])
  @@index([sortaId])
  @@index([obrisano])
}

model IzlazVina {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tankId         String
  tip            TipIzlazaVina
  datum          DateTime      @default(now()) @db.Timestamptz(6)
  kolicinaLitara Float
  brojBoca       Int?
  volumenBoce    Float?
  napomena       String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  tank           Tank          @relation(fields: [tankId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tankId])
  @@index([datum])
  @@index([tip])
}

model ArhivaPunjenjeTanka {
