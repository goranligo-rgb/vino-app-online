model PutnikAkcijaKupca {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  templateId String?
  template   PutnikAkcijaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  naziv String
  opis  String?

  datumPocetka   DateTime?
  datumZavrsetka DateTime?

  kolicinaKupnje Int?
  gratisKolicina Int?

