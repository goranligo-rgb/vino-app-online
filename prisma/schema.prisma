  updatedAt               DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  arhivaPunjenje          ArhivaPunjenjeTanka @relation(fields: [arhivaPunjenjeId], references: [id], onDelete: Cascade)

  @@index([arhivaPunjenjeId])
