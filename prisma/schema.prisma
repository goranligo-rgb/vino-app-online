  radiSezonski       Boolean @default(false)
  promet             String?
  najjaciDani        String?

  // 2. TRENUTNA PONUDA
  prodajeKucnoVino  Boolean @default(false)
  prodajeButelje    Boolean @default(false)
  prodajeRinfuza    Boolean @default(false)
  prodajePremium    Boolean @default(false)
  prodajeStranaVina Boolean @default(false)
  prodajePjenusce   Boolean @default(false)
