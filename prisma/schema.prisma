generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(uuid())
  ime            String
  username       String?       @unique
  email          String        @unique
  password       String
  role           Role
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  activityLogs   ActivityLog[]
  additions      Addition[]
  measurements   Measurement[]
  mixings        Mixing[]
  mjerenja       Mjerenje[]
  radnje         Radnja[]
  transfers      Transfer[]
  zadaciIzvrseni Zadatak[]     @relation("ZadatakIzvrsio")
  zadaciZadani   Zadatak[]     @relation("ZadatakZadao")
  tankKomande    TankKomanda[]
  pretoci            Pretok[]
  punjenjaTanka      PunjenjeTanka[]
  izlaziVina         IzlazVina[]
  radnePrijave       RadnaPrijava[] @relation("RadnaPrijavaKorisnik")
  radnePrijaveUredio RadnaPrijava[] @relation("RadnaPrijavaUredio")
  zaliheZapisi       PreparationStockEntry[]
}

model Tank {
  id                   String                @id @default(uuid())
  broj                 Int                   @unique
  kapacitet            Float
  kolicinaVinaUTanku   Float?                @default(0)
  tip                  String?
  opis                 String?
  createdAt            DateTime              @default(now())
  sorta                String?
  nazivVina            String?
  godiste              Int?
  // --- Nadzor temperature (Faza A): sve nullable, aditivno na postojeci Tank ---
  modbusAdresa         Int?                  @unique
  grana                String?               // "A" = tankovi 1-20, "B" = 21-44
  // Proziva li gateway ovaj tank? false = tank postoji, ali nema kontroler
  // hladjenja (npr. 41-44). Adresa se cuva, ali se ne salje nijedan upit.
  nadzorHladjenja      Boolean               @default(true)
  // Salje li se SMS kad ovaj tank ode u alarm temperature? false utisava SAMO
  // poruku - alarm se i dalje otvara, broji i crveni na ekranu. Sluzi za tank
  // koji se zna da je izvan granica (punjenje, pretok, tank koji se hladi
  // danima) da ne budi ljude svakih 15 min.
  smsAktivan           Boolean               @default(true)
  // Provjerava li samokontrola hladjenja ovaj tank? false = tank je namjerno
  // "nelogican" (jabucno-mlijecna fermentacija, maceracija, tank u pripremi) pa
  // se ne javlja. Ne utjece ni na alarme ni na SMS - samo na taj podsjetnik.
  samokontrolaAktivna  Boolean               @default(true)
  zadanaTemp           Decimal?              @db.Decimal(4, 1)
  alarmMinus           Decimal?              @default(2.0) @db.Decimal(3, 1)
  alarmPlus            Decimal?              @default(2.0) @db.Decimal(3, 1)
  // Hy = diferencijal hladjenja na Dixellu (0,1-3,0 K). Faza B.
  hy                   Decimal?              @db.Decimal(3, 1)
  // Soft-OFF: kontroler nema Modbus registar za ON/OFF, pa se hladjenje gasi
  // podizanjem set pointa na SOFT_OFF_TEMP (20,0 C). Ovdje se pamti zadana
  // temperatura od prije iskljucenja da ju "UKLJUCI" moze vratiti.
  zadnjaZadanaTemp     Decimal?              @db.Decimal(4, 1)
  additions            Addition[]
  blendIzvori          BlendIzvor[]          @relation("CiljniBlendTank")
  kaoIzvorBlenda       BlendIzvor[]          @relation("IzvorBlendTank")
  documents            Document[]
  izlaziVina           IzlazVina[]
  measurements         Measurement[]
  targetMixings        Mixing[]              @relation("TargetTankMixings")
  mixingSources        MixingSource[]
  mjerenja             Mjerenje[]
  pretociKaoCilj       Pretok[]              @relation("CiljniPretoci")
  pretociKaoIzvor      PretokIzvor[]         @relation("IzvorniPretoci")
  pretokMjerenja       PretokMjerenje[]
  pretokSnapshoti      PretokSnapshot[]
  punjenja             PunjenjeTanka[]
  radnje               Radnja[]
  currentContent       TankContent?
  udjeliSorti          TankSortaUdio[]
  sourceTransfers      Transfer[]            @relation("SourceTankTransfers")
  targetTransfers      Transfer[]            @relation("TargetTankTransfers")
  zadaci               Zadatak[]             @relation("ZadatakTank")
  zadaciVezaniCilj     Zadatak[]             @relation("ZadatakVezaniCiljTank")
  zadatakStavkeKaoCilj ZadatakTankStavka[]
  ocitanjaTemp         OcitanjeTemperature[]
  tankAlarmi           TankAlarm[]
  komande              TankKomanda[]
}

// Ocitanje temperature tanka (telemetrija sa sonde / Modbus ploce).
// Faza A: puni se seedom testnih podataka; kasnije pise hardverski sloj.
model OcitanjeTemperature {
  id                String   @id @default(cuid())
  tankId            String
  temperatura       Decimal  @db.Decimal(4, 1)
  zadanaTemperatura Decimal  @db.Decimal(4, 1)
  hladjenjeAktivno  Boolean
  status            String // "OK" | "ALARM" | "OFFLINE"
  mjerenoU          DateTime
  tank              Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId, mjerenoU(sort: Desc)])
}

// Aktivan/rijesen alarm tanka (previsoka temp, greska sonde, nema veze).
model TankAlarm {
  id          String    @id @default(cuid())
  tankId      String
  tip         String // "PREVISOKA_TEMP" | "GRESKA_SONDE" | "NEMA_VEZE"
  poruka      String
  aktivan     Boolean   @default(true)
  nastaoU     DateTime  @default(now())
  razrijesenU DateTime?
  // Kad je za ovaj alarm poslan SMS (Infobip). NULL = nije poslan. Sluzi kao
  // brava protiv ponavljanja: SMS ide jednom, tek kad alarm potraje
  // SMS_ODGODA_MIN, a "opet OK" SMS se salje samo ako je ovo popunjeno.
  // Stanje je u bazi, a ne u gatewayu, da ga restart servisa ne izgubi.
  smsPoslanU  DateTime?
  tank        Tank      @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId])
}

// Dnevnik poslanih SMS obavijesti (Infobip). Dvije uloge:
//   1. trag "sto je, kome i kada poslano" (i sto je Infobip odbio);
//   2. stanje za heartbeat watchdog - je li za trenutni ispad SMS vec poslan.
// Namjerno BEZ relacije na Tank: dnevnik mora prezivjeti brisanje tanka, a
// tankId/tankBroj su tu samo kao podsjetnik o cemu se radilo.
model SmsObavijest {
  id         String   @id @default(cuid())
  // "ALARM" | "OPORAVAK" | "HEARTBEAT" | "HEARTBEAT_OK" | "TEST"
  tip        String
  izvor      String // "GATEWAY" (Pi) | "WATCHDOG" (cron nad bazom)
  tankId     String?
  tankBroj   Int?
  alarmId    String?
  tekst      String
  primatelji String // brojevi odvojeni zarezom, onako kako su poslani
  uspjeh     Boolean
  greska     String?
  poslanoU   DateTime @default(now())

  @@index([tip, poslanoU(sort: Desc)])
  @@index([poslanoU(sort: Desc)])
}

// Zahtjev za promjenu parametra tanka (zadana temp, alarm pragovi, hladjenje ON/OFF).
// Faza A: komanda samo stoji NA_CEKANJU - nista se ne salje hardveru (gateway ne postoji).
model TankKomanda {
  id            String    @id @default(cuid())
  tankId        String
  tip           String // "ZADANA_TEMP" | "ALARM_MINUS" | "ALARM_PLUS" | "HY" | "HLADJENJE_ON" | "HLADJENJE_OFF"
  vrijednost    Decimal?  @db.Decimal(4, 1) // null za ON/OFF
  status        String    @default("NA_CEKANJU") // "NA_CEKANJU" | "PRIMIJENJENO" | "NEUSPJELO"
  trazioUserId  String
  trazenoU      DateTime  @default(now())
  primijenjenoU DateTime?
  greska        String?
  tank          Tank      @relation(fields: [tankId], references: [id], onDelete: Cascade)
  trazioUser    User      @relation(fields: [trazioUserId], references: [id])

  @@index([tankId, trazenoU(sort: Desc)])
  @@index([status])
}

model Pretok {
  id         String           @id @default(uuid())
  datum      DateTime         @default(now())
  ciljTankId String
  napomena   String?
  createdAt  DateTime         @default(now())
  tip        String           @default("OBICNI")
  korisnikId String?
  ciljTank   Tank             @relation("CiljniPretoci", fields: [ciljTankId], references: [id])
  korisnik   User?            @relation(fields: [korisnikId], references: [id])
  izvori     PretokIzvor[]
  mjerenja   PretokMjerenje[]
  snapshoti  PretokSnapshot[]

  @@index([ciljTankId])
  @@index([createdAt])
  @@index([tip])
  @@index([korisnikId])
}

model PretokIzvor {
  id       String @id @default(uuid())
  pretokId String
  tankId   String
  kolicina Float
  pretok   Pretok @relation(fields: [pretokId], references: [id], onDelete: Cascade)
  tank     Tank   @relation("IzvorniPretoci", fields: [tankId], references: [id])

  @@index([pretokId])
  @@index([tankId])
}

model PretokSnapshot {
  id             String                @id @default(uuid())
  pretokId       String
  tankId         String
  uloga          String
  brojTanka      Int?
  kolicinaPrije  Float?
  sortaPrije     String?
  nazivVinaPrije String?
  godistePrije   Int?
  kapacitetPrije Float?
  tipTankaPrije  String?
  opisPrije      String?
  createdAt      DateTime              @default(now())
  pretok         Pretok                @relation(fields: [pretokId], references: [id], onDelete: Cascade)
  tank           Tank                  @relation(fields: [tankId], references: [id])
  blendovi       PretokSnapshotBlend[]
  sorte          PretokSnapshotSorta[]

  @@index([pretokId])
  @@index([tankId])
  @@index([uloga])
}

model PretokSnapshotSorta {
  id         String         @id @default(uuid())
  snapshotId String
  nazivSorte String
  postotak   Float
  createdAt  DateTime       @default(now())
  snapshot   PretokSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
}

model PretokSnapshotBlend {
  id                String         @id @default(uuid())
  snapshotId        String
  izvorTankId       String?
  izvorArhivaVinaId String?
  nazivVina         String?
  sorta             String?
  kolicina          Float
  postotak          Float
  createdAt         DateTime       @default(now())
  snapshot          PretokSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([izvorTankId])
  @@index([izvorArhivaVinaId])
}

model PretokMjerenje {
  id         String   @id @default(uuid())
  pretokId   String
  mjerenjeId String   @unique
  tankId     String
  createdAt  DateTime @default(now())
  mjerenje   Mjerenje @relation(fields: [mjerenjeId], references: [id], onDelete: Cascade)
  pretok     Pretok   @relation(fields: [pretokId], references: [id], onDelete: Cascade)
  tank       Tank     @relation(fields: [tankId], references: [id])

  @@index([pretokId])
  @@index([tankId])
}

model TankSortaUdio {
  id         String   @id @default(uuid())
  tankId     String
  nazivSorte String
  postotak   Float
  createdAt  DateTime @default(now())
  tank       Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
}

model Sorta {
  id             String           @id @default(uuid())
  naziv          String           @unique
  aktivna        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  punjenjeStavke PunjenjeStavka[]
}

model Preparat {
  id              String     @id @default(uuid())
  naziv           String     @unique
  strucnoIme      String
  preporucenaDoza Float
  mjernaJedinica  String
  izlaznaJedinica String
  opis            String?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  dozaDo          Float?
  dozaOd          Float?
  unitId          String?
  additions       Addition[]
}

model Addition {
  id                 String      @id @default(uuid())
  datum              DateTime
  userId             String
  tankId             String
  preparationId      String
  doza               Float
  jedinica           String
  volumenUTanku      Float
  izracunataKolicina Float
  izlaznaJedinica    String
  napomena           String?
  createdAt          DateTime    @default(now())
  preparatId         String?
  preparat           Preparat?   @relation(fields: [preparatId], references: [id])
  preparation        Preparation @relation(fields: [preparationId], references: [id])
  tank               Tank        @relation(fields: [tankId], references: [id])
  user               User        @relation(fields: [userId], references: [id])
}

model Transfer {
  id           String   @id @default(uuid())
  datum        DateTime
  userId       String
  sourceTankId String
  targetTankId String
  kolicina     Float
  napomena     String?
  createdAt    DateTime @default(now())
  sourceTank   Tank     @relation("SourceTankTransfers", fields: [sourceTankId], references: [id])
  targetTank   Tank     @relation("TargetTankTransfers", fields: [targetTankId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model Mixing {
  id           String         @id @default(uuid())
  datum        DateTime
  userId       String
  targetTankId String
  total        Float
  alkohol      Float?
  kiseline     Float?
  napomena     String?
  createdAt    DateTime       @default(now())
  targetTank   Tank           @relation("TargetTankMixings", fields: [targetTankId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  sources      MixingSource[]
}

model MixingSource {
  id           String @id @default(uuid())
  mixingId     String
  sourceTankId String
  kolicina     Float
  mixing       Mixing @relation(fields: [mixingId], references: [id], onDelete: Cascade)
  sourceTank   Tank   @relation(fields: [sourceTankId], references: [id])
}

model Measurement {
  id          String   @id @default(uuid())
  datum       DateTime
  tankId      String
  userId      String
  alkohol     Float?
  kiseline    Float?
  ph          Float?
  secer       Float?
  temperatura Float?
  napomena    String?
  createdAt   DateTime @default(now())
  tank        Tank     @relation(fields: [tankId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Document {
  id               String             @id @default(uuid())
  tankId           String
  vrsta            VrstaDokumentaVina
  naziv            String
  fileName         String
  fileUrl          String
  mimeType         String?
  datumDokumenta   DateTime?
  napomena         String?
  uploadedByUserId String?
  uploadedByIme    String?
  createdAt        DateTime           @default(now())
  tank             Tank               @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId])
  @@index([vrsta])
  @@index([datumDokumenta])
}

model ActivityLog {
  id         String   @id @default(uuid())
  datum      DateTime
  userId     String
  tip        String
  entityType String
  entityId   String
  opis       String
  payload    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model TankContent {
  id         String   @id @default(uuid())
  tankId     String   @unique
  sorta      String
  kolicina   Float
  datumUlaza DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tank       Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
}

model Unit {
  id                              String                  @id @default(uuid())
  naziv                           String
  tip                             String?
  faktor                          Float?
  preparationStockUnits           Preparation[]           @relation("PreparationStockUnit")
  preparations                    Preparation[]
  stockEntries                    PreparationStockEntry[]
  radnje                          Radnja[]
  zadaciKaoIzlaznaJedinica        Zadatak[]               @relation("ZadatakIzlaznaJedinica")
  zadaciKaoJedinica               Zadatak[]               @relation("ZadatakJedinica")
  zadatakStavkeKaoIzlaznaJedinica ZadatakStavka[]         @relation("ZadatakStavkaIzlaznaJedinica")
  zadatakStavkeKaoJedinica        ZadatakStavka[]         @relation("ZadatakStavkaJedinica")
}

model Preparation {
  id                         String                  @id @default(uuid())
  naziv                      String
  opis                       String?
  dozaOd                     Float?
  dozaDo                     Float?
  unitId                     String?
  strucnoIme                 String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  isKorekcijski              Boolean                 @default(false)
  korekcijaTip               KorekcijaTip?
  korekcijaJedinica          String?
  ucinakPoJedinici           Float?
  povecanjeParametra         Float?
  referentnaKolicina         Float?
  referentnaKolicinaJedinica String?
  referentniVolumen          Float?
  referentniVolumenJedinica  String?
  stanjeNaSkladistu          Float?                  @default(0)
  minimalnaKolicina          Float?                  @default(0)
  skladisnaJedinicaId        String?
  aktivan                    Boolean?                @default(true)
  additions                  Addition[]
  skladisnaJedinica          Unit?                   @relation("PreparationStockUnit", fields: [skladisnaJedinicaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit                       Unit?                   @relation(fields: [unitId], references: [id])
  skladisniUlazi             PreparationStockEntry[]
  radnje                     Radnja[]
  zadaci                     Zadatak[]
  zadatakStavke              ZadatakStavka[]
}

/// Dnevnik zaliha preparata: svaka promjena stanja ostavlja zapis.
/// Ulaz, izlaz (izvrsenje zadatka), rucna korekcija i pocetno stanje.
model PreparationStockEntry {
  id            String          @id @default(uuid())
  preparationId String

  /// Kako je uneseno, u jedinici unitId. Uvijek pozitivno.
  /// NIJE knjizeni iznos - vidi promjenaSkladisna.
  kolicina      Float
  unitId        String?

  datum         DateTime?       @default(now()) @db.Timestamp(6)
  dobavljac     String?
  brojDokumenta String?
  napomena      String?
  createdAt     DateTime?       @default(now()) @db.Timestamp(6)

  tip           TipZaliheZapisa @default(ULAZ)

  /// Knjizeni iznos: s predznakom, UVIJEK u skladisnoj jedinici preparata.
  ///
  /// Stanje preparata racuna se ISKLJUCIVO kao SUM(promjenaSkladisna),
  /// NIKAD kao SUM(kolicina). Razlog: kolicina je zapisana u jedinici unosa
  /// (uneseno 2 kg), a stanje se pomice u skladisnoj jedinici (2000 g), pa
  /// su jedinice po retcima izmijesane i njihov zbroj nema znacenje.
  ///
  /// Invarijanta: SUM(promjenaSkladisna) po preparatu == Preparation.stanjeNaSkladistu
  promjenaSkladisna Float       @default(0)

  /// false = zapis je od prije uvodenja dnevnika. Takav redak ima
  /// promjenaSkladisna = 0: vidi se u prometu, ali ne ulazi u zbroj.
  /// Cuva ga i CHECK ogranicenje PreparationStockEntry_uKnjizi_chk u bazi.
  uKnjizi       Boolean         @default(true)

  /// Tko je proveo promjenu. Null za zatecene ulaze - podatak nije postojao.
  korisnikId    String?

  /// Izlaz nastaje izvrsenjem zadatka; radnja nosi tank i vino.
  radnjaId      String?

  preparation   Preparation     @relation(fields: [preparationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit          Unit?           @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  korisnik      User?           @relation(fields: [korisnikId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  radnja        Radnja?         @relation(fields: [radnjaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([preparationId])
  @@index([datum])
  @@index([korisnikId])
  @@index([radnjaId])
}

model Mjerenje {
  id                String          @id @default(cuid())
  tankId            String
  korisnikId        String?
  alkohol           Float?
  ukupneKiseline    Float?
  hlapiveKiseline   Float?
  slobodniSO2       Float?
  ukupniSO2         Float?
  secer             Float?
  ph                Float?
  temperatura       Float?
  bentotestDatum    DateTime?
  bentotestStatus   String?
  izmjerenoAt       DateTime        @default(now())
  napomena          String?
  jeRucno           Boolean         @default(true)
  korisnik          User?           @relation(fields: [korisnikId], references: [id])
  tank              Tank            @relation(fields: [tankId], references: [id], onDelete: Cascade)
  pretokVeze        PretokMjerenje?
  pocetnoZaPunjenja PunjenjeTanka[] @relation("PocetnoMjerenjePunjenja")

  @@index([tankId, izmjerenoAt])
}

model Zadatak {
  id                 String              @id @default(uuid())
  tankId             String
  zadaoKorisnikId    String
  izvrsioKorisnikId  String?
  vrsta              VrstaZadatka
  naslov             String?
  napomena           String?
  preparatId         String?
  doza               Float?
  jedinicaId         String?
  volumenUTanku      Float?
  izracunataKolicina Float?
  izlaznaJedinicaId  String?
  status             StatusZadatka       @default(OTVOREN)
  zadanoAt           DateTime            @default(now())
  izvrsenoAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tipZadatka         String?
  vezanaVrsta        VrstaZadatka?
  vezaniBrojDana     Int?
  vezaniNaslov       String?
  vezanaNapomena     String?
  parentZadatakId    String?
  zakljucanDo        DateTime?
  tipKorekcije       KorekcijaTip?
  trenutnaVrijednost Float?
  zeljenaVrijednost  Float?
  // --- Filtracija povlaci pretok vina: sve nullable, aditivno ---
  kolicinaIzlaz      Float?
  gubitakLitara      Float?
  snapshotJson       Json?
  vezaniCiljTankId   String?
  // --- Maceracija: NAPUSTENO, polja se vise ne pisu ni ne citaju ---------
  // Maceracija se dogadja na GROZDJU, prije nego most uopce udje u tank, dakle
  // prije nego ijedan zadatak postoji. Ovdje je zavrsila usput uz flotaciju i
  // to je bilo pogresno: zadatak nastaje nakon punjenja, pa je pitanje na
  // krivom mjestu i za flotaciju koja se radi dan-dva kasnije.
  //
  // Podatak sada zivi na PunjenjeStavka.maceracija / .maceracijaSati, uz
  // ostale podatke berbe (parcela, vinograd, secer...).
  //
  // Kolone OSTAJU u bazi namjerno: nullable su, nijedan zapis ih nema
  // popunjene (provjereno 23.08.2026: 0 od 11 zadataka), i nista ih ne pise.
  // Brisanje kolona na produkcijskoj bazi usred berbe nema nikakvu dobit, a
  // nosi rizik. NE koristiti ih u novom kodu.
  maceracija         Boolean?
  maceracijaOpis     String?
  radnjas            Radnja[]
  izlaznaJedinica    Unit?               @relation("ZadatakIzlaznaJedinica", fields: [izlaznaJedinicaId], references: [id])
  izvrsioKorisnik    User?               @relation("ZadatakIzvrsio", fields: [izvrsioKorisnikId], references: [id])
  jedinica           Unit?               @relation("ZadatakJedinica", fields: [jedinicaId], references: [id])
  preparat           Preparation?        @relation(fields: [preparatId], references: [id])
  tank               Tank                @relation("ZadatakTank", fields: [tankId], references: [id])
  vezaniCiljTank     Tank?               @relation("ZadatakVezaniCiljTank", fields: [vezaniCiljTankId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  zadaoKorisnik      User                @relation("ZadatakZadao", fields: [zadaoKorisnikId], references: [id])
  stavke             ZadatakStavka[]
  tankStavke         ZadatakTankStavka[]

  @@index([vezaniCiljTankId])
}

// Stavka filtracije: u koji ciljni tank i koliko litara ulazi.
// Zadatak "Filtracija" nosi izlaz (Zadatak.kolicinaIzlaz) i 1..n ovakvih ulaza.
model ZadatakTankStavka {
  id         String   @id @default(uuid())
  zadatakId  String
  ciljTankId String
  kolicina   Float
  redoslijed Int      @default(0)
  createdAt  DateTime @default(now())
