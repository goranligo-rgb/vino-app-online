model PutnikKupac {
  id String @id @default(cuid())

  nazivLokala  String
  nazivFirme   String?
  vlasnik      String?
  kontaktOsoba String?

  telefon String?
  email   String?
  oib     String?

  adresa String?
  grad   String?
  regija String?

  // Excel kartica kupca - identifikacija
  sifraKupca String?

  // Odgovorna osoba za narudžbu
  narudzbaOsoba   String?
  narudzbaTelefon String?
  narudzbaEmail   String?

  // Odgovorna osoba za naplatu
  naplataOsoba   String?
  naplataTelefon String?
  naplataEmail   String?

  // Financijski uvjeti
  nacinPlacanja     String?
  garancijaPlacanja String?
  kreditniLimit     Float?

  gpsLat Float?
  gpsLng Float?

  tip        PutnikTipKupca        @default(OSTALO)
  status     PutnikKupacStatus     @default(POTENCIJALNI)
  kategorija PutnikKupacKategorija @default(C)

  napomena String?

  aktivan Boolean @default(true)

  ankete          PutnikAnketaKupca[]
  posjeti         PutnikPosjet[]
  akcije          PutnikAkcijaKupca[]
  promoMaterijali PutnikPromoKupca[]
  rezultati       PutnikRezultatObilaska[]
  dogovori        PutnikDogovor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

