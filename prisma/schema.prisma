  glavniKonkurent              String?
  razlogCijena                 Boolean @default(false)
  razlogPoznatost              Boolean @default(false)
  razlogKvaliteta              Boolean @default(false)
  razlogRabat                  Boolean @default(false)
  razlogDostava                Boolean @default(false)
  razlogOdnosDobavljac         Boolean @default(false)
  razlogGostiTraze             Boolean @default(false)
  razlogKonobariProdaju        Boolean @default(false)
  razlogCasePromo              Boolean @default(false)
