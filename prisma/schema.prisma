  ciljTank   Tank     @relation(fields: [ciljTankId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([zadatakId, ciljTankId])
  @@index([zadatakId])
  @@index([ciljTankId])
}

