  vaznaKvaliteta           Boolean @default(false)
  vaznaMarza               Boolean @default(false)
  vaznaDostava             Boolean @default(false)
  vazanBrend               Boolean @default(false)
  vaznaLokalnaPrica        Boolean @default(false)
  vaznaPreporukaHrane      Boolean @default(false)
  vaznaEdukacijaKonobara   Boolean @default(false)
  vazneCase                Boolean @default(false)
  vazanPromoMaterijal      Boolean @default(false)
  vazneAkcije              Boolean @default(false)
  vaznaSigurnostDobave     Boolean @default(false)
  vaznaJednostavnaNarudzba Boolean @default(false)

  // 8. NAŠA VINA / KOSTANJEVEC
  probaoNasaVina        String?
  misljenjeONama        String?
  poznajeVinariju       Boolean @default(false)
  cuoZaNas              Boolean @default(false)
  bioUVinariji          Boolean @default(false)
  zanimaGaPricaVinarije Boolean @default(false)

  // 9. MOTIVACIJA
  motiviraBoljaCijena      Boolean @default(false)
  motiviraAkcija12Plus2    Boolean @default(false)
  motiviraAkcija6Plus1     Boolean @default(false)
  motivirajuProbneBoce     Boolean @default(false)
  motivirajuCase           Boolean @default(false)
  motiviraVinskaKarta      Boolean @default(false)
  motiviraEdukacija        Boolean @default(false)
  motiviraDegustacija      Boolean @default(false)
  motiviraWineParty        Boolean @default(false)
  motiviraPosjetVinariji   Boolean @default(false)
  motiviraBoljaMarza       Boolean @default(false)
  motiviraPreporukaUzHranu Boolean @default(false)
  motiviraLokalnaPrica     Boolean @default(false)

