  promoMaterijalAktivacija Boolean @default(false)
  stalciLetciAktivacija    Boolean @default(false)
  posebnaCijenaAktivacija  Boolean @default(false)
  preporukaHraneVina       Boolean @default(false)
  lokalnaPricaAktivacija   Boolean @default(false)
  premiumPozicioniranje    Boolean @default(false)

  preporucenaKolicina      Int?
  preporucenaCijena        String?
  preporuceniRok           String?
  preporucenaAkcijaDetalji String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikPosjet {
  id      String      @id @default(cuid())
  kupacId String
  kupac   PutnikKupac @relation(fields: [kupacId], references: [id], onDelete: Cascade)

  datum     DateTime @default(now())
  putnikIme String?

  zainteresiran     Boolean @default(false)
  nijeZainteresiran Boolean @default(false)
  uzimaNaseVino     Boolean @default(false)
  uzimaKonkurenciju Boolean @default(false)
  zeliPonudu        Boolean @default(false)
  zeliUzorke        Boolean @default(false)
  zeliEdukaciju     Boolean @default(false)
  zeliWineParty     Boolean @default(false)
  ponovnoObici      Boolean @default(false)

  dogovoreno     String?
  biljeska       String?
  sljedeciKorak  String?
  datumSljedeceg DateTime?

  // Excel kartica kupca - reklamni materijal i dug
  reklamniMaterijal String?
  ukupanDug         Float?
  dospjeliDug       Float?

  stavke PutnikPosjetStavka[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PutnikPosjetStavka {
  id       String       @id @default(cuid())
  posjetId String
  posjet   PutnikPosjet @relation(fields: [posjetId], references: [id], onDelete: Cascade)

  nazivProizvoda String
  kolicina       Float?
  jedinica       String? @default("kom")

  createdAt DateTime @default(now())

  @@index([posjetId])
}

model PutnikAkcijaTemplate {
  id    String  @id @default(cuid())
  naziv String
